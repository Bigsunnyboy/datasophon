<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.datasophon.dao.mapper.ClusterExistingComponentMapper">

    <!-- 根据集群ID和服务名称查询现有组件 -->
    <select id="listByClusterAndService" resultType="com.datasophon.dao.entity.ClusterExistingComponentEntity">
        SELECT *
        FROM t_ddh_cluster_existing_component
        WHERE cluster_id = #{clusterId}
          AND service_name = #{serviceName}
        ORDER BY detection_time DESC
    </select>

    <!-- 根据集群ID、服务名称和主机名查询组件 -->
    <select id="getByClusterServiceAndHost" resultType="com.datasophon.dao.entity.ClusterExistingComponentEntity">
        SELECT *
        FROM t_ddh_cluster_existing_component
        WHERE cluster_id = #{clusterId}
          AND service_name = #{serviceName}
          AND hostname = #{hostname}
    </select>

    <!-- 根据组件状态查询 -->
    <select id="listByState" resultType="com.datasophon.dao.entity.ClusterExistingComponentEntity">
        SELECT *
        FROM t_ddh_cluster_existing_component
        WHERE cluster_id = #{clusterId}
          AND component_state = #{componentState}
        ORDER BY detection_time DESC
    </select>

    <!-- 更新组件状态 -->
    <update id="updateComponentState">
        UPDATE t_ddh_cluster_existing_component
        SET component_state = #{componentState},
            update_time = NOW()
        WHERE id = #{id}
    </update>

    <!-- 批量更新组件状态 -->
    <update id="batchUpdateComponentState">
        UPDATE t_ddh_cluster_existing_component
        SET component_state = #{componentState},
            update_time = NOW()
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>